{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origenes": [ "http://localhost:4200", "https://rutarola.netlify.app" ]
  },
  "Jwt": {
    "Emisor": "rutarola-api",
    "Audiencia": "rutarola",
    "MinutosAcceso": 15,
    "DiasRefresh": 30,
    "SegundosGraciaRotacion": 30
  },
  "Seguridad": {
    "IntentosAutenticacionPorMinuto": 10
  },
  "BaseDatos": {
    "MigrarAlIniciar": false
  },
  "Procesos": {
    "Habilitado": true,
    "IntervaloMinutos": 15
  },
  "Mensajeria": {
    "Whatsapp": "Deshabilitado",
    "Correo": "Deshabilitado"
  },
  "Seed": {
    "Empresa": { "Nombre": "RutaRola Demo", "Nit": "900000001-1", "Ciudad": "Bogotá" },
    "Admin": { "Usuario": "admin", "Email": "admin@rutarola.com", "Nombre": "Administrador demo" },
    "SuperAdmin": { "Usuario": "superadmin", "Email": "superadmin@rutarola.com" }
  }
}
